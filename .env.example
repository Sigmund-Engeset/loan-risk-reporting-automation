# Copy to .env and fill in. .env is git-ignored: never commit it.
DATA_SOURCE=csv                      # csv | snowflake

SNOWFLAKE_ACCOUNT=ORGNAME-ACCOUNTNAME
SNOWFLAKE_USER=YOUR_USERNAME
SNOWFLAKE_ROLE=LOAN_REPORTING_RO
SNOWFLAKE_WAREHOUSE=LOAN_WH

# Option 1 (recommended): key-pair authentication. Keep the key OUTSIDE this repo.
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# Option 2: password + MFA push (used when SNOWFLAKE_PRIVATE_KEY_PATH is empty)
SNOWFLAKE_PASSWORD=
